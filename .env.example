# ============================================================================
# DSH Docker 部署 —— 环境变量模板（精简版）
#
# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会进入 git
#
# 本文件只保留日常部署需要关注的 12 项；其他高级调优（RESCUE_* 自愈细节、
# NODE_MAX_OLD_SPACE / PIDS_LIMIT / SOCAT_MAX_CHILDREN / NPM_REGISTRY / TZ /
# DEEPSEEK_API_KEY_FILE 等）的默认值已写在 docker-compose.yml 的 ${VAR:-default}
# 兜底里，需要时直接编辑 docker-compose.yml，或在 .env 中追加同名变量覆盖。
# 完整速查表见 docs/zh-CN/07-环境变量速查.md（英文 docs/en/07-environment-variables.md）。
# ============================================================================

# ── ★ 必填：模型 API 密钥 ────────────────────────────────────────────────
# DSH 从环境变量读取，不落盘。换 key 改这里后 docker compose up -d 即可。
DEEPSEEK_API_KEY=sk-你的密钥

# ── 镜像与容器 ──────────────────────────────────────────────────────────
# 默认 ghcr.io 公共镜像（ghcr 要求小写）；本地构建可改 dsh-base:final 等自定义 tag
DSH_IMAGE=ghcr.io/steven-stack-s/dsh-docker-server:latest
DSH_CONTAINER_NAME=dsh

# ── 外部访问端口 ─────────────────────────────────────────────────────────
# 宿主机端口 → socat 转发到容器内 dsh 的 127.0.0.1:3081
DSH_PORT=3080

# ── 持久化目录（NAS 部署按需改为 NAS 卷挂载路径） ───────────────────────
# 相对路径基于 docker-compose.yml 所在目录；可改绝对路径（如 /volume1/docker/dsh/...）
PROGRAMS_DIR=./programs    # DSH 程序本体（npm 全局包，可容器内升级）
DSH_DATA_DIR=./dsh         # DSH 用户数据（会话/配置/插件/凭据/记忆库）
WORKSPACE_DIR=./workspace  # agent 工作区

# ── 容器内非 root 运行用户（安全加固，通常无需设置） ───────────────────────
# 不设即 1000:1000 —— 多数 NAS/宿主首个非 root 用户，与上面三个挂载卷属主最友好。
# entrypoint 首启会把三个卷 chown 到此用户后降权运行（root 只做首启初始化）。
# 仅当宿主上这三个卷的属主【不是 1000】、且你希望以那个 uid 运行时，才取消注释并改写。
# ⚠ 该 uid 最好能在容器 /etc/passwd 里查到（镜像自带 1000 = node 用户）。
#   填一个查不到的 uid 不会导致启动失败，但 entrypoint 会退化为"不带附加组"降权。
# 注：旧版本这里写"须与 Dockerfile 构建参数一致"是错的 —— 镜像已不再声明该 build-arg，
#     真正的来源只是下面这两行环境变量（compose 侧另有 :-1000 兜底）。
# USER_UID=1000
# USER_GID=1000

# ── ★ /api Host 信任白名单（无 dsh-remote 时局域网访问必填） ─────────────
# dsh 0.1.2 起仅信任 loopback 或白名单 Host。未装认证插件 dsh-remote 时，局域网 IP
# 或隧道域名访问必须填入，否则页面能打开但 /api 报 403。逗号分隔，可带端口。
# 示例：192.168.1.5:3080,app.xx.ugdocker.link
# 装了 dsh-remote（账号密码登录）：登录后其 trustProxy 会把请求 Host 归一为
# loopback，此白名单不需要填（填了也无害）。
# 两者都没配 = 仅本机 loopback 可访问。
DSH_TRUSTED_HOSTS=

# ── 资源限制（按宿主机配置调整；N100 + 8GB 示例给系统留余量） ──────────
MEM_LIMIT=2g
CPU_LIMIT=2

# ── 救生舱（lifeboat）总闸 ───────────────────────────────────────────────
# RESCUE=1 时 docker compose up -d 进入救生舱（回退到固定 dsh 版本），
# 修好插件后改回 RESCUE=0 重建即可恢复正常 profile。
# 日常保持 0；只在 rescue lifeboat status 提示需进入救生舱时改为 1。
RESCUE=0
# 自动干预总闸：on=启动失败自动归因并按需回退快照/摘插件；
# off=只诊断+写 incident，不自动改动插件树（排查期间建议 off）。
# 与 RESCUE_SELFHEAL 取与：任一为 off 都只诊断不自动改。
RESCUE_AUTO=on
